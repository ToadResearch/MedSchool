# Latest Synthea FHIR sample bundles (R4)
# https://github.com/synthetichealth/synthea-sample-data/tree/main/downloads/latest
SYNTHEA_ZIP_URL=https://synthetichealth.github.io/synthea-sample-data/downloads/latest/synthea_sample_data_fhir_latest.zip

########################################
# LLM API Keys
########################################

OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=


########################################
# Core App & Networking
########################################

# Bind address for local servers (0.0.0.0 to accept external connections; 127.0.0.1 for local only)
LOCAL_ADDRESS=0.0.0.0

# Internal container ports (static; what processes bind to inside containers)
HAPI_CONTAINER_PORT=8080              # HAPI FHIR server
DB_CONTAINER_PORT=5432                # Postgres
MCP_CONTAINER_PORT=8000               # MCP server
SANDBOX_CONTAINER_PORT=8088           # Code execution sandbox
MIDDLEMAN_CONTAINER_PORT=3000         # Middleman
VALIDATOR_CONTAINER_PORT=3500         # FHIR Validator
UPLOADER_CONTAINER_PORT=8001          # Bulk uploader HTTP server

# Host-published ports (can change to avoid conflicts)
HAPI_PORT=8080              # HAPI FHIR server
DB_PORT=5432                # Postgres
MCP_PORT=8000               # MCP server
SANDBOX_PORT=8088           # Code execution sandbox
MIDDLEMAN_PORT=3000         # Middleman
VALIDATOR_PORT=3500         # FHIR Validator

########################################
# Derived Hosts (safe defaults)
########################################
# Where services bind vs. what the host dials
BIND_HOST=${LOCAL_ADDRESS}
LOOPBACK_HOST=127.0.0.1

########################################
# Alpine Sandbox
########################################
ALPINE_MEM_MB=256
ALPINE_CPUS=0.5


########################################
# HAPI FHIR Server
########################################
# TODO: not used yet, maybe add support later
# HAPI_VERSION=8.2.0
# FHIR_FLAVOUR=r4


########################################
# MCP Server
########################################
MCP_HOST=${BIND_HOST}
MCP_HTTP_PATH=/mcp


########################################
# Terminology Server (R4)
########################################

# TODO: add local support for REMOTE_TS_ENABLED=false (and load terminology packages into HAPI)
# If true, delegate terminology ops ($lookup/$validate-code/$expand) to a remote TS.
# If false, serve from vocabularies loaded locally into HAPI.
REMOTE_TS_ENABLED=true
REMOTE_TS_BASE=https://tx.fhir.org/r4 # used when REMOTE_TS_ENABLED=true


########################################
# Sandbox
########################################
SANDBOX_EXEC_TIMEOUT_S=6
SANDBOX_EXEC_MEM_MB=512
SANDBOX_EXEC_CPUS=1.0


########################################
# Validation
########################################

TX_SERVER_URL=https://tx.fhir.org
VALIDATOR_PREWARM=true
VALIDATOR_PREWARM_SV=4.0.1
VALIDATOR_PREWARM_TIMEOUT=90
VALIDATOR_STARTUP_WAIT=30



########################################
# Middleman Routes & Upstream URLs
########################################

# ----- Route path segments exposed by Middleman (client-facing prefixes) -----
# Keep these as simple path slugs; clients will call: http://<host>:<MIDDLEMAN_PORT>/<slug>/...
FHIR_ROUTE=fhir_server
TERMINOLOGY_ROUTE=terminology_server
VALIDATION_ROUTE=validation_server
OPENFDA_ROUTE=openfda_api
MCP_ROUTE=mcp_server
SANDBOX_ROUTE=sandbox_server
VM_ROUTE=vm
TERMINAL_ROUTE=terminal


# ----- Upstream targets (where Middleman forwards) -----
# IMPORTANT: Use container-internal addresses here (service name + container port).
# HAPI listens on container port 8080; do NOT use ${HAPI_PORT} here.
HAPI_INTERNAL_BASE=http://hapi:${HAPI_CONTAINER_PORT} # HAPI Spring Boot defaults to 8080
HAPI_INTERNAL_FHIR_BASE=${HAPI_INTERNAL_BASE}/fhir
FHIR_UPSTREAM_BASE=${HAPI_INTERNAL_BASE}

TERMINOLOGY_UPSTREAM_BASE=${REMOTE_TS_BASE}          

VALIDATION_UPSTREAM_BASE=http://validator:${VALIDATOR_CONTAINER_PORT}

OPENFDA_UPSTREAM_BASE=https://api.fda.gov

MCP_UPSTREAM_BASE=http://mcp:${MCP_CONTAINER_PORT}

SANDBOX_UPSTREAM_BASE=http://sandbox:${SANDBOX_CONTAINER_PORT}

# terminal connections are looped back to middleman itself, which handles terminal sessions
TERMINAL_UPSTREAM_BASE=http://middleman:${MIDDLEMAN_CONTAINER_PORT}/interminal


# ----- Middleman bases (bind/public/internal) -----
MIDDLEMAN_BASE=http://${BIND_HOST}:${MIDDLEMAN_PORT}
MIDDLEMAN_PUBLIC_BASE=http://${LOOPBACK_HOST}:${MIDDLEMAN_PORT}
MIDDLEMAN_INTERNAL_BASE=http://middleman:${MIDDLEMAN_CONTAINER_PORT}

# ----- Proxied bases (prefixes; no trailing /fhir unless noted) -----
FHIR_PROXY_BASE=${MIDDLEMAN_BASE}/${FHIR_ROUTE}
FHIR_PROXY_PUBLIC_BASE=${MIDDLEMAN_PUBLIC_BASE}/${FHIR_ROUTE}
FHIR_PROXY_INTERNAL_BASE=${MIDDLEMAN_INTERNAL_BASE}/${FHIR_ROUTE}

TERMINOLOGY_PROXY_BASE=${MIDDLEMAN_BASE}/${TERMINOLOGY_ROUTE}
TERMINOLOGY_PROXY_PUBLIC_BASE=${MIDDLEMAN_PUBLIC_BASE}/${TERMINOLOGY_ROUTE}
TERMINOLOGY_PROXY_INTERNAL_BASE=${MIDDLEMAN_INTERNAL_BASE}/${TERMINOLOGY_ROUTE}

VALIDATION_PROXY_BASE=${MIDDLEMAN_BASE}/${VALIDATION_ROUTE}
VALIDATION_PROXY_PUBLIC_BASE=${MIDDLEMAN_PUBLIC_BASE}/${VALIDATION_ROUTE}
VALIDATION_PROXY_INTERNAL_BASE=${MIDDLEMAN_INTERNAL_BASE}/${VALIDATION_ROUTE}

OPENFDA_PROXY_BASE=${MIDDLEMAN_BASE}/${OPENFDA_ROUTE}
OPENFDA_PROXY_PUBLIC_BASE=${MIDDLEMAN_PUBLIC_BASE}/${OPENFDA_ROUTE}
OPENFDA_PROXY_INTERNAL_BASE=${MIDDLEMAN_INTERNAL_BASE}/${OPENFDA_ROUTE}

# not used because in docker/mcp_server/server.py we see that fastmcp doesn't accept full addresses, just parts like host and port
# MCP_PROXY_BASE=${MIDDLEMAN_BASE}/${MCP_ROUTE}
# MCP_PROXY_PUBLIC_BASE=${MIDDLEMAN_PUBLIC_BASE}/${MCP_ROUTE}
# MCP_PROXY_INTERNAL_BASE=${MIDDLEMAN_INTERNAL_BASE}/${MCP_ROUTE}

# SANDBOX_PROXY_BASE=${MIDDLEMAN_BASE}/${SANDBOX_ROUTE}
# SANDBOX_PROXY_PUBLIC_BASE=${MIDDLEMAN_PUBLIC_BASE}/${SANDBOX_ROUTE}
# SANDBOX_PROXY_INTERNAL_BASE=${MIDDLEMAN_INTERNAL_BASE}/${SANDBOX_ROUTE}

TERMINAL_PROXY_BASE=${MIDDLEMAN_BASE}/${TERMINAL_ROUTE}
TERMINAL_PROXY_PUBLIC_BASE=${MIDDLEMAN_PUBLIC_BASE}/${TERMINAL_ROUTE}
TERMINAL_PROXY_INTERNAL_BASE=${MIDDLEMAN_INTERNAL_BASE}/${TERMINAL_ROUTE}

# ----- Canonical client URLs (what host-side clients/scripts should call) -----
FHIR_BASE_URL=${FHIR_PROXY_PUBLIC_BASE}/fhir
TERMINOLOGY_BASE_URL=${TERMINOLOGY_PROXY_PUBLIC_BASE}
VALIDATION_BASE_URL=${VALIDATION_PROXY_PUBLIC_BASE}
OPENFDA_BASE_URL=${OPENFDA_PROXY_PUBLIC_BASE}
# MCP_BASE_URL=${MCP_PROXY_PUBLIC_BASE}/mcp
# SANDBOX_BASE_URL=${SANDBOX_PROXY_PUBLIC_BASE}
TERMINAL_BASE_URL=${TERMINAL_PROXY_PUBLIC_BASE}

# -----  Health endpoints from the host -----
FHIR_METADATA_URL=${FHIR_BASE_URL}/metadata
MIDDLEMAN_HEALTH_URL=${MIDDLEMAN_PUBLIC_BASE}/sessions/health
# MCP_HEALTH_URL=${MCP_BASE_URL}/health
# SANDBOX_HEALTH_URL=${SANDBOX_BASE_URL}/healthz


########################################
# Database (Postgres for HAPI)
########################################

PGUSER=admin
PGPASSWORD=admin
PGDATABASE=hapi

# Connection strings (internal vs host)
POSTGRES_INTERNAL_URL=postgresql://${PGUSER}:${PGPASSWORD}@db:${DB_CONTAINER_PORT}/${PGDATABASE}
POSTGRES_PUBLIC_URL=postgresql://${PGUSER}:${PGPASSWORD}@${LOOPBACK_HOST}:${DB_PORT}/${PGDATABASE}


# ──────────── Ports & URLs ────────────
HAPI_PORT=8081
DB_PORT=5432

MCP_PORT=8000
MCP_HOST=0.0.0.0 # 127.0.0.1 will only accept connections from inside docker container
MCP_HTTP_PATH=/mcp

SANDBOX_PORT=8088

MIDDLEMAN_PORT=3000

LOCAL_ADDRESS=localhost

FHIR_SERVER_ROUTE=fhir_server
TERMINOLOGY_SERVER_ROUTE=terminology

# ──────────── FHIR ────────────
# leave blank for 'http://localhost:<HAPI_PORT>/fhir'
FHIR_BASE_URL=


# ──────────── Terminology ────────────

# HAPI FHIR terminology server (TS) delegation
# true  → delegate $lookup/$validate-code/$expand to a remote TS
# false → serve from vocabularies loaded locally into HAPI
REMOTE_TS_ENABLED=true
REMOTE_TS_BASE=https://tx.fhir.org/r4

# MCP terminology client base (used by MCP tools)
# If REMOTE_TS_ENABLED=true, keep this pointing to the remote TS.
# If REMOTE_TS_ENABLED=false, point this at HAPI (gateway or internal):
#   from host via gateway: http://localhost:${HAPI_PORT}/fhir
#   inside the docker net: http://hapi:8080/fhir
TERMINOLOGY_BASE_URL=https://tx.fhir.org/r4


# ──────────── Auth ────────────
# Shared symmetric key that both the HAPI container and token-generator use.
# https://cloud.google.com/network-connectivity/docs/vpn/how-to/generating-pre-shared-key
JWT_SHARED_SECRET=CpTvTthsGaubAYJ0CJKsaNO8U6rIkETQ

# A valid HS256 JWT generated by fhir_server/scripts/generate_jwt.sh
# Leave blank until you run the script, then paste the token here.
FHIR_BEARER_TOKEN=


# ──────────── Postgres ────────────
PGUSER=admin
PGPASSWORD=admin
PGDATABASE=hapi

# ──────────── Synthea sample bundles (R4) ────────────
# https://github.com/synthetichealth/synthea-sample-data/tree/main/downloads/latest
SYNTHEA_ZIP_URL=https://synthetichealth.github.io/synthea-sample-data/downloads/latest/synthea_sample_data_fhir_latest.zip


# ──────────── Sandbox runner ────────────
# default is http://localhost:${SANDBOX_PORT}
MCP_PYEXEC_EXECUTOR_URL=

# ──────────── Validator ────────────
TX_SERVER_URL=https://tx.fhir.org
VALIDATOR_PREWARM=true
VALIDATOR_PREWARM_SV=4.0.1
VALIDATOR_PREWARM_TIMEOUT=90
VALIDATOR_STARTUP_WAIT=30


# ──────────── API Keys ────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=